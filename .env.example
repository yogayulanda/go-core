# Safe local example configuration for go-core consumers.
# Optional integrations are commented out because presence enables them.

SERVICE_NAME=example-service
APP_ENV=local
LOG_LEVEL=info
GRPC_PORT=50051
HTTP_PORT=8080
METRICS_ENABLED=false
HTTP_CORS_ALLOWED_ORIGINS=
AUTH_SIGNATURE_MASTER_KEY=

# Database: use either sqlserver or mysql; add aliases to DB_LIST.
DB_LIST=
# DB_LIST=primary
# DB_PRIMARY_DRIVER=mysql
# DB_PRIMARY_HOST=127.0.0.1
# DB_PRIMARY_PORT=3306
# DB_PRIMARY_NAME=example_db
# DB_PRIMARY_USER=example_user
# DB_PRIMARY_PASSWORD=
# DB_PRIMARY_PARAMS=parseTime=true

# REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=
# MEMCACHED_SERVERS=127.0.0.1:11211
# KAFKA_BROKERS=127.0.0.1:9092
# Set username/password/mechanism together for SASL; supported mechanisms are PLAIN and SCRAM-SHA-256/512.
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=
# KAFKA_JKS_FILE accepts JKS or PEM; JKS uses KAFKA_JKS_PASSWORD.
KAFKA_JKS_FILE=
KAFKA_JKS_PASSWORD=
# APM_ENDPOINT=localhost:4317 (OpenTelemetry OTLP to Elastic APM Server; no Elastic APM agent)
DIAG_ENABLED=true
HTTP_PPROF_ENABLED=false